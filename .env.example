# Access gate. When set, every page and API route needs a cadai_access cookie.
# Open https://<host>/?access=<token> once; the server sets the cookie and drops the parameter.
# Use a long random value (e.g. `openssl rand -hex 32`; it goes in a URL, so avoid + / =). Unset = no gate (local use only).
CADAI_ACCESS_TOKEN=
# Maximum runs building at once across all processes (default 4; 0 = no cap).
CADAI_MAX_RUNNING=4
# Daily (UTC) build budget in USD. New builds get 429 once today's committed cost plus
# CADAI_MAX_RUNNING x the per-run cap would reach it. Unset = no ceiling.
CADAI_DAILY_COST_USD=
# Set to 1 behind a TLS-terminating proxy so x-forwarded-proto decides the Secure cookie flag.
CADAI_TRUST_PROXY=
