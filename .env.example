# Object store: "local" (default; files under CADAI_RUN_DIR/objects) or "s3".
# When unset, setting S3_BUCKET selects the S3 store.
CADAI_ARTIFACT_STORE=
# S3-compatible bucket (private; the app streams bytes and never hands out object URLs).
S3_BUCKET=
# Region, e.g. us-east-1 (R2: auto).
S3_REGION=
# Optional custom endpoint for R2 or MinIO, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# 1 for path-style addressing (MinIO).
S3_FORCE_PATH_STYLE=
# Credentials come from the AWS SDK default chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, a profile, or an instance role).
