# Experiential Labs API key for model routing
EXPLABS_API_KEY=

# Concept sheets generation and 2D review loop ('on' | 'off', default 'on')
CADAI_SPEC_SHEETS=on

# Max retries for automated sheet review before forwarding to gate (default 5)
CADAI_SPEC_REVIEW_RETRIES=5

# Timeout budget in ms for spec review loop when deployed on Vercel (default 240000)
CADAI_SPEC_REVIEW_BUDGET_MS=240000

# Maximum number of concept variants the architect plans and specs (default 3)
CADAI_MAX_VARIANTS=3

# Drafter starting strategy: 'blockout' provides starting script scaffold, 'scratch' does not (default 'blockout')
CADAI_DRAFTER_START=blockout

# Model override for visual design critic evaluations
CADAI_CRITIC_MODEL=
